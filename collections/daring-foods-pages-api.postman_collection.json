  "info": {
    "_postman_id": "9ac9fc75-4ac7-4b79-b29c-aa9fb344a43d",
    "name": "Daring Foods Pages API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Public, unauthenticated read access to the 17 static pages that make up daring.com - Home, Products, Our Mission, Ingredients, How To Cook, Locator, FAQ, Careers, Accessibility Statement, Terms & Conditions, VIP, and the Foodservice sub-tree (Foodservice, Products, Mission, How To Cook, Support, Store Locator) - via the WordPress REST API. Unlike the custom post types on this host, pages DO return their full rendered `content` and `excerpt`, which makes this the collection to read when harvesting Daring's own statements about ingredients, sourcing, sustainability claims and foodservice terms. Pages are hierarchical: the Foodservice sub-pages carry a non-zero `parent`.\n\nContact Support:\n Name: Daring Foods",
      "type": "text/plain"
    }
  }
