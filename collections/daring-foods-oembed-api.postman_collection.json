  "info": {
    "_postman_id": "c47dbe49-26c4-4491-be66-82b098c294b9",
    "name": "Daring Foods O Embed API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "daring.com is a registered oEmbed 1.0 provider: any public daring.com URL - a recipe, a product page, a marketing page - can be resolved to embeddable rich metadata (title, author, thumbnail, and an iframe `html` payload) in a single unauthenticated call. The endpoint is advertised in the site's HTML head via `application/json+oembed` and `text/xml+oembed` link relations, and it answers in both JSON and XML. This is the lowest-friction way to get a titled, illustrated card for a Daring recipe without touching the content collections. The related /oembed/1.0/proxy route requires authentication (verified HTTP 401 anonymously) and is not documented here.\n\nContact Support:\n Name: Daring Foods",
      "type": "text/plain"
    }
  }
