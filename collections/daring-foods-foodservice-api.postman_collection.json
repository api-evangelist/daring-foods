  "info": {
    "_postman_id": "e708e10b-3bab-42bd-911a-dbad11c754eb",
    "name": "Daring Foods Products Foodservice API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Public, unauthenticated read access to the Daring foodservice catalog at https://daring.com/foodservice/products/ via the site's custom `foodservice-products` post type on the WordPress REST API. This is the bulk/B2B line sold to restaurants, campus dining and institutional kitchens - distinct from the retail `products` collection - and held 7 published items at time of capture (observed in the X-WP-Total header), including the Unbreaded Gluten-Free Diced Plant Chicken. As with the other custom post types on this host, the Advanced Custom Fields payload is empty over REST, so case specifications, yields and distributor data are not retrievable through the API.\n\nContact Support:\n Name: Daring Foods",
      "type": "text/plain"
    }
  }
